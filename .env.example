# ============================================================
# VARIABLES DE ENTORNO
# Copiar este archivo a .env.local y completar localmente.
# Nunca guardar credenciales reales en Git.
# ============================================================

# Supabase: configuración pública del proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: secreto exclusivo del servidor.
SUPABASE_SECRET_KEY=

# Correo transaccional. Configurar cuando se implemente.
RESEND_API_KEY=

# Secreto criptográfico para operaciones OTP.
# Generar un valor aleatorio seguro antes de utilizarlo.
OTP_HMAC_SECRET=

# Integración de pagos Azul: futura configuración.
# Los secretos y credenciales deben permanecer en el servidor.
AZUL_API_KEY=
AZUL_MERCHANT_ID=
